# Traccar OsmAnd-compatible endpoint used by once and daemon.
TRACCAR_URL=http://traccar:5055

POLL_INTERVAL_SECONDS=900
LOCATION_TIMEOUT_SECONDS=30
DEVICE_REFRESH_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
TZ=UTC

# Optional: comma-separated Find Hub device IDs. Empty selects all devices.
# DEVICE_IDS=

# Optional Compose host path and external Docker network.
# RELAY_DATA_DIR=./relay-data
# TRACKING_NETWORK=tracking
